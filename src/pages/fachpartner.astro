---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Fachpartner | Zertifizierte Installateure | meine-waermepumpe.at"
  description="Finden Sie zertifizierte CHOFU Wärmepumpen-Installateure in Ihrer Region. Qualifizierte Partner in ganz Österreich."
>
  <div class="bg-slate-50 min-h-screen py-12">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-flex items-center gap-2 mb-4 bg-primary/10 text-primary px-4 py-1.5 text-sm font-bold rounded-full">
          Zertifizierte Installateure
        </span>
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-slate-900 mb-6">
          Unsere Fachpartner in ganz Österreich
        </h1>
        <p class="text-xl text-slate-600">
          Qualifizierte Installateure für Ihre neue Wärmepumpe. Alle Partner sind von uns geschult und zertifiziert.
        </p>
      </div>
      <div id="partner-list">
        <noscript>
          <p class="text-center text-slate-500">Bitte aktivieren Sie JavaScript, um die Partnerliste zu laden.</p>
        </noscript>
      </div>
    </div>
  </div>
</BaseLayout>
