---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Heizkostenrechner | Wärmepumpe dimensionieren | meine-waermepumpe.at"
  description="Berechnen Sie Ihre Heizkosten und finden Sie die passende CHOFU Wärmepumpe. Kostenloser Online-Rechner für Österreich."
>
  <div class="bg-slate-50 min-h-screen">
    <div id="calculator-container">
      <noscript>
        <div class="container mx-auto px-4 py-20 text-center">
          <p class="text-slate-500">Bitte aktivieren Sie JavaScript, um den Heizkostenrechner zu nutzen.</p>
        </div>
      </noscript>
    </div>
  </div>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>
